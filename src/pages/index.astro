          <div class="absolute inset-0 card-gradient opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute top-3 right-3">
            <span class="bg-primary/90 text-on-primary text-[9px] font-black uppercase tracking-[0.15em] px-3 py-1 rounded-sm">New Release</span>

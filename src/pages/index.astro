          <span class="px-2.5 py-1 bg-primary/10 border border-primary/20 text-primary text-[9px] font-bold tracking-wider rounded-full">Breeding</span>
        </div>
      </div>

      <div class="flex-none w-48 md:w-72 group cursor-pointer transition-all duration-500 hover:-translate-y-2">
        <div class="aspect-[2/3] relative rounded-sm overflow-hidden bg-surface-container-high ring-1 ring-white/5 border-2 border-primary/30">

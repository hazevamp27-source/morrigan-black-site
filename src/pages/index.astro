          <img alt="Minotaur's Mark" class="w-full h-full object-cover" src="/images/covers/1_VWcover.jpg"/>
          <div class="absolute inset-0 card-gradient opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-0 left-0 p-4 md:p-6 translate-y-4 group-hover:translate-y-0 transition-all duration-300 opacity-0 group-hover:opacity-100">

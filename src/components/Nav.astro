---
interface Props {
  active: 'home' | 'books';
}

const { active } = Astro.props;

const links = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'Books', href: '/books', key: 'books' },
  { label: 'Audiobooks', href: '/#audiobooks-section' },
  { label: 'About', href: '/#about-section' },
  { label: 'Contact', href: '/#contact-section' },
];
---

<!-- ===== NAV ===== -->
<nav class="fixed top-0 w-full z-50 glass-nav" id="mainNav">
  <div class="flex justify-between items-center w-full px-6 md:px-8 py-4 md:py-5">
    <div class="flex items-center gap-8 md:gap-12">
      <a href="/" class="text-xl md:text-2xl font-extrabold tracking-tighter text-primary">Morrigan Black</a>
      <div class="hidden md:flex items-center gap-8 font-headline text-xs tracking-[0.2em] uppercase">
        {links.map((link) => (
          <a class={link.key === active ? 'text-primary font-bold border-b-2 border-primary pb-1' : 'text-on-surface/60 hover:text-primary transition-colors'} href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-4">
      <a href="https://www.youtube.com/@MorriganBlack" target="_blank" rel="noopener noreferrer"
         class="hidden sm:inline-flex items-center gap-2 bg-youtube-red/10 border border-youtube-red/30 text-youtube-red px-5 py-2 rounded-sm text-xs font-bold uppercase tracking-[0.15em] hover:bg-youtube-red/20 transition-all">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">play_circle</span>
        YouTube
      </a>
      <a href="https://www.patreon.com/c/MorriganBlack452" target="_blank" rel="noopener noreferrer"
         class="hidden sm:inline-flex items-center gap-2 bg-patreon-coral/10 border border-patreon-coral/30 text-patreon-coral px-5 py-2 rounded-sm text-xs font-bold uppercase tracking-[0.15em] hover:bg-patreon-coral/20 transition-all">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">loyalty</span>
        Join Patreon
      </a>
      <button class="md:hidden text-on-surface/80 hover:text-primary transition-colors p-1" id="mobileToggle" aria-label="Toggle menu">
        <span class="material-symbols-outlined text-2xl" id="menuIcon">menu</span>
      </button>
    </div>
  </div>
  <div class="mobile-menu md:hidden px-6 bg-surface-container-lowest/95 backdrop-blur-xl border-t border-primary/10" id="mobileMenu">
    <div class="flex flex-col gap-4 py-6 font-headline text-sm tracking-[0.15em] uppercase">
      {links.map((link) => (
        <a class={link.key === active ? 'text-primary font-bold' : 'text-on-surface/60 hover:text-primary transition-colors'} href={link.href}>{link.label}</a>
      ))}
      <a href="https://www.youtube.com/@MorriganBlack" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center justify-center gap-2 bg-youtube-red text-white px-6 py-3 rounded-sm text-xs font-bold uppercase tracking-[0.15em] mt-2">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">play_circle</span>
        YouTube
      </a>
      <a href="https://www.patreon.com/c/MorriganBlack452" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center justify-center gap-2 bg-patreon-coral text-white px-6 py-3 rounded-sm text-xs font-bold uppercase tracking-[0.15em]">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">loyalty</span>
        Join Patreon
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('mainNav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      nav.style.background = 'rgba(10, 10, 10, 0.92)';
    } else {
      nav.style.background = 'rgba(10, 10, 10, 0.7)';
    }
  });

  const mobileToggle = document.getElementById('mobileToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuIcon = document.getElementById('menuIcon');
  mobileToggle.addEventListener('click', () => {
    mobileMenu.classList.toggle('open');
    menuIcon.textContent = mobileMenu.classList.contains('open') ? 'close' : 'menu';
  });

  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      menuIcon.textContent = 'menu';
    });
  });
</script>
